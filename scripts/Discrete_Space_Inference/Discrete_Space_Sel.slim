initialize() {
    // initializeSex("A"); 
    defineConstant("SubpopSize", 1000);
    if (!exists("MIG")) 
        defineConstant("MIG", 0.05);
    defineConstant("Migration", MIG);
    defineConstant("pop", 10);
    defineConstant("matrix_size", pop * pop);
    if (!exists("id_replica"))
        defineConstant("id_replica", 1);    
    if (!exists("Sel_V"))
        defineConstant("Sel_V", 0.01);
    if (!exists("MODEL"))
        defineConstant("MODEL", "neutros");
    defineConstant("OUTPUT_PATH", "/mnt/data/dortega/hlopezh/Inf_MigSelection/data/results_Discrete/outputs_slim/independent_loci/" + MODEL + "/");
    if (MODEL == "neutros") {
        actual_sel = 0.0;
    } else {
        actual_sel = Sel_V;
    }
    defineConstant("MU", 1.29e-8);
    initializeMutationRate(MU);
    initializeMutationType("m1", 0.5, "f", actual_sel);
    initializeGenomicElementType("g1", m1, 1.0);
    initializeGenomicElement(g1, 0, 999); 
    initializeRecombinationRate(0.5);
}

1 early() {
	defineGlobal("tiempo_inicial", clock());
	metapopSide = pop;
	metapopSize = pop*pop;
	for (i in 1:metapopSize)
		sim.addSubpop(i, SubpopSize);
	
	subpops = sim.subpopulations;
	for (x in 1:metapopSide)
		for (y in 1:metapopSide) {
			destID = (x - 1) + (y - 1) * metapopSide + 1;
			ds = subpops[destID - 1];
			if (x > 1) ds.setMigrationRates(destID - 1, Migration);
			if (x < metapopSide) ds.setMigrationRates(destID + 1, Migration);
			if (y > 1) ds.setMigrationRates(destID - metapopSide, Migration);
			if (y < metapopSide) ds.setMigrationRates(destID + metapopSide, Migration);
		}
	
	// Precalcula x_pos/y_pos por subpop una sola vez (id -> coordenadas fijas)
	n = asInteger(sqrt(matrix_size));
	defineGlobal("N_GRID", n);
	idx = 0:(matrix_size - 1);
	defineGlobal("X_POS", (idx % n) + 1);
	defineGlobal("Y_POS", asInteger(idx / n) + 1);
	
	// Buffer de escritura y frecuencia de volcado
	defineGlobal("WRITE_BUFFER", string(0));
	defineConstant("FLUSH_EVERY", 20); // ajustable
	filename = OUTPUT_PATH + "D_FULL_" + MODEL + "_m1_" + id_replica + ".csv";
    defineGlobal("OUT_FILE", filename);
	header = "Cycle,MutID,X,Y,Freq,Count,Total";
    writeFile(OUT_FILE, header, append=F);
}

1:1000 late() {
    if (sim.cycle % 20 == 0) catn("Tick: " + sim.cycle);

    muts_m1 = sim.mutationsOfType(m1);

    if (size(muts_m1) > 0) {
        mut_ids = muts_m1.id;
        new_lines = string(0);

        for (subpop in sim.subpopulations) {
            counts = sim.mutationCounts(subpop, muts_m1);   // una entrada por mutación
            present = counts > 0;
            if (!any(present)) next;

            chr_tot = 2 * subpop.individualCount;
            index   = subpop.id - 1;
            valid_counts = counts[present];
            valid_freqs  = valid_counts / chr_tot;
            valid_ids    = mut_ids[present];

            lines = sim.cycle + "," + valid_ids + "," + X_POS[index] + "," +
                    Y_POS[index] + "," + valid_freqs + "," + valid_counts + "," + chr_tot;

            new_lines = c(new_lines, lines);
        }

        if (size(new_lines) > 0)
            defineGlobal("WRITE_BUFFER", c(WRITE_BUFFER, new_lines));
    }

    // El volcado queda fuera del "if" para que ocurra aunque no haya mutaciones ese ciclo
    if (sim.cycle % FLUSH_EVERY == 0 | sim.cycle == 1000) {
        if (size(WRITE_BUFFER) > 0) {
            writeFile(OUT_FILE, WRITE_BUFFER, append=T);
            defineGlobal("WRITE_BUFFER", string(0));
        }
    }
}