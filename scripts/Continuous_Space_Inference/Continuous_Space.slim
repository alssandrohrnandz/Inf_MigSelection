initialize() {
	initializeSLiMModelType("nonWF");
	initializeSLiMOptions(dimensionality="xy");

	// --- Parámetros ecológicos ---
	if (!exists("MIG"))
		defineConstant("MIG", 0.05);
	defineConstant("SIGMA", MIG);
	defineConstant("MU", 1.29e-8);
	defineConstant("LIFETIME", 2);
	defineConstant("FECUN", 1 / LIFETIME);
	defineConstant("MAP_WIDTH", 1.0);

	// --- Parámetros genéticos desde bash (idéntico al script discreto) ---
	if (!exists("Sel_V"))
		defineConstant("Sel_V", 0.01);
	if (!exists("MODEL"))
		defineConstant("MODEL", "neutros");
	if (!exists("id_replica"))
		defineConstant("id_replica", 1);

	if (MODEL == "neutros") {
		actual_sel = 0.0;
	} else {
		actual_sel = Sel_V;
	}

	// --- Modelo de cromosoma: un único bloque de 1000 pb con m1 ---
	initializeMutationRate(MU);
	initializeMutationType("m1", 0.5, "f", actual_sel);   // s viene de bash
	initializeGenomicElementType("g1", m1, 1.0);          // solo m1
	initializeGenomicElement(g1, 0, 999);                 // 1000 pb
	initializeRecombinationRate(0.5);                     // recombinación libre (loci independientes)

	// --- Constantes del modelo ---
	defineConstant("K", 10000);
	defineConstant("N", 10000);
	defineConstant("GRID_SIZE", 10);  // grilla virtual para el registro
	defineConstant("OUTPUT_PATH",
		"/mnt/data/dortega/hlopezh/Inf_MigSelection/data/results_Continuous/outputs_slim/independent_loci_test_sel/" + MODEL + "/");

	// --- Movimiento ---
	defineConstant("SD", SIGMA);
	defineConstant("SV", SIGMA);
	defineConstant("SM", SIGMA);

	// --- Interacciones espaciales ---
	initializeInteractionType(1, "xy", reciprocal=T, maxDistance=SD*3);   // competencia
	i1.setInteractionFunction("n", 1.0, SD);

	initializeInteractionType(2, "xy", reciprocal=T, maxDistance=SM*3);   // apareamiento
	i2.setInteractionFunction("n", 1.0, SM);
}

1 first() {
	sim.addSubpop("p1", N);
	p1.setSpatialBounds(c(0.0, 0.0, MAP_WIDTH, MAP_WIDTH));
	p1.individuals.setSpatialPosition(p1.pointUniform(p1.individualCount));
	catn("Tick: " + sim.cycle + " Pob: " + p1.individualCount);

	// --- Preparación del archivo de salida (formato igual al discreto) ---
	filename = OUTPUT_PATH + "C_FULL_" + MODEL + "_m1_" + id_replica + ".csv";
	defineGlobal("OUT_FILE", filename);
	defineConstant("FLUSH_EVERY", 20);
	writeFile(OUT_FILE, "Cycle,MutID,X,Y,Freq,Count,Total", append=F);

	defineGlobal("WRITE_BUFFER", string(0));
}

first() {
	if (SV > 0) {
		p1.deviatePositions(p1.individuals, "reflecting", INF, "n", SV);
	}
	i2.evaluate(p1);
}

reproduction() {
	// La selección ahora es intrínseca al tipo de mutación m1 (fitness effect).
	// No se aplica manualmente el multiplicador de fecundidad.
	mate = i2.drawByStrength(individual, 1);
	if (mate.size()) {
		children = subpop.addCrossed(individual, mate, count=rpois(1, 2 * FECUN));
		for (child in children) {
			pos = individual.spatialPosition + rnorm(2, 0, SD);
			child.setSpatialPosition(p1.pointReflected(pos));
		}
	}
}

early() {
	offspring = p1.subsetIndividuals(maxAge=0);
	p1.deviatePositions(offspring, "reprising", INF, "n", SD);
	i1.evaluate(p1);
	inds = p1.individuals;
	density = i1.localPopulationDensity(inds);
	u = density / ((1 + FECUN) * 9000);
	inds.fitnessScaling = 1.0 / (1.0 + FECUN * u);
	// Nota: fitnessScaling se combina multiplicativamente con el efecto
	// de las mutaciones m1 => la selección actúa vía supervivencia.
}

late() {
	if (sim.cycle % 100 == 0)
		catn("Tick: " + sim.cycle + " Pob: " + p1.individualCount +
		     " Mutaciones segregando: " + sim.mutations.size());
	if (p1.individualCount == 0) {
		catn("Population went extinct! Ending the simulation.");
		sim.simulationFinished();
	}
}

// ------------------------------------------------------------------
// Registro de frecuencias alélicas en celdas 10x10
// (mismo formato y lógica de buffer que el script de espacio discreto)
// ------------------------------------------------------------------
1:1000 late() {
	if (sim.cycle % 10 == 0) catn("Tick: " + sim.cycle);

	muts_m1 = sim.mutationsOfType(m1);

	if (size(muts_m1) > 0) {
		inds = p1.individuals;

		if (size(inds) > 0) {
			// Asignar cada individuo a una celda (0..GRID_SIZE-1)
			xs = asInteger(floor((inds.x / MAP_WIDTH) * GRID_SIZE));
			ys = asInteger(floor((inds.y / MAP_WIDTH) * GRID_SIZE));
			xs = ifelse(xs >= GRID_SIZE, GRID_SIZE - 1, xs);
			ys = ifelse(ys >= GRID_SIZE, GRID_SIZE - 1, ys);
			bin_ids = xs * GRID_SIZE + ys;

			tick_lines = string(0);

			for (x in 0:(GRID_SIZE - 1)) {
				for (y in 0:(GRID_SIZE - 1)) {
					bin_id = x * GRID_SIZE + y;
					in_cell = inds[bin_ids == bin_id];
					if (size(in_cell) == 0) next;

					// Todos los haplosomas de la celda
					all_genomes = in_cell.haplosomes;
					chr_tot = size(all_genomes);

					// Solo las mutaciones presentes en esta celda
					cell_muts = unique(all_genomes.mutations);

					for (m in cell_muts) {
						if (m.mutationType != m1) next;
						count = sum(all_genomes.containsMutations(m));
						freq = count / asFloat(chr_tot);
						line = paste(c(sim.cycle, m.id, x + 1, y + 1,
						               freq, count, chr_tot), sep=",");
						tick_lines = c(tick_lines, line);
					}
				}
			}

			defineGlobal("WRITE_BUFFER", c(WRITE_BUFFER, tick_lines));
		}
	}

	if (sim.cycle % FLUSH_EVERY == 0 | sim.cycle == 1000) {
		if (length(WRITE_BUFFER) > 0) {
			writeFile(OUT_FILE, paste(WRITE_BUFFER, sep="\n"), append=T);
			defineGlobal("WRITE_BUFFER", string(0));
		}
	}
}